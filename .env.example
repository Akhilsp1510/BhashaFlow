# ==============================================================================
# BHASHAFLOW ENVIRONMENT CONFIGURATION TEMPLATE
# IIT Kharagpur DataForge × Rime Hackathon 2026
#
# INSTRUCTIONS:
# Copy this file to .env.local and fill in your authorized credentials.
# NEVER commit .env.local or expose API keys in client-side code.
# ==============================================================================

# Rime API Credentials (Server-side only)
RIME_API_KEY=your_rime_api_key_placeholder
RIME_API_ENDPOINT=https://users.rime.ai
RIME_WS_ENDPOINT=wss://users.rime.ai/ws3
RIME_DEFAULT_MODEL=arcana-v3
RIME_DEFAULT_SPEAKER=seraphina

# LiveKit Transport Credentials
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_placeholder
LIVEKIT_API_SECRET=your_livekit_api_secret_placeholder

# Speech-to-Text Provider (Optional / Fallback)
SARVAM_API_KEY=your_sarvam_api_key_placeholder
DEEPGRAM_API_KEY=your_deepgram_api_key_placeholder

# Application Environment
NODE_ENV=development
VITE_APP_MODE=mock_fixture_fallback
